@startuml
'https://plantuml.com/sequence-diagram
!theme spacelab

title Startup & Device Creation — Provider Registration Flow

participant "System" as Sys
participant "DeviceFactory" as DF
participant "Provider Catalog" as PC
participant "BlaubergMVHRPlugin" as Plugin
participant "ModbusClientRegistry" as MCR
participant "BlaubergMVHR\n(Device)" as Dev

== Startup: provider registration ==
Sys -> DF : new DeviceFactory(configFactory)
DF -> PC : device providers()
PC --> DF : [BlaubergMVHRPlugin, ModbusTempSensorPlugin, ...]
note over DF : providers indexed by deviceType()\nAdding an extension is all it takes\nto introduce a new device

MCR -> PC : transport providers()
PC --> MCR : [TcpFactory, RtuFactory]

== Runtime: create a device ==
Sys -> DF : createDevice("blauberg_mvhr")
DF -> DF : validate registered + requiredDependencies()
alt not registered or missing dependency
  DF --> Sys : DeviceResponse(EXCEPTION, details)
else ok
  DF -> Plugin : create(configLoader, dependencies)
  Plugin -> MCR : get(TCP, connectionSettings)
  MCR --> Plugin : Response<ModbusClient>\n(wrapped in ConnectionManager)
  Plugin --> DF : device
  DF --> Sys : DeviceResponse(VALID, device)
  Sys -> Dev : start()
  Dev -> Dev : connect + poll loop
end

@enduml
