@startuml
'https://plantuml.com/class-diagram
!theme spacelab

title Device Plugin Architecture — Extensible Devices

interface Device {
  +open(): CompletableFuture<Response<Void>>
  +read(query: DeviceQuery): CompletableFuture<Response<DeviceState>>
  +execute(command: DeviceCommand): CompletableFuture<Response<Void>>
  +close(): void
}

interface DeviceQuery
note right of DeviceQuery
  Intent-driven read request. The device maps
  the query to the required protocol operations.
  Examples for MVHR: ReadSnapshot,
  ReadTemperatures, ReadAirQuality, ReadAlarms.
  A snapshot is explicit, not an accidental
  consequence of calling read without parameters.
end note

interface DeviceCommand
note right of DeviceCommand
  Intent-driven operation requested by a caller.
  Commands are device-specific and are translated
  by the device into protocol-level writes.
  Examples for MVHR: SetPower, SetFanSpeed,
  SetTemperature, ResetFilterTimer.
end note

interface DevicePlugin {
  +deviceType(): DeviceType
  +requiredDependencies(): Set<DependencyKey>
  +create(config: ConfigLoader, deps: Dependencies): Device
}
note right of DevicePlugin
  Provider contract for device extensions.
  Each new device is supplied as an independent
  extension — the core framework and existing
  devices are NEVER modified.
  (Open/Closed Principle)
end note

class DeviceFactory {
  -plugins: Map<DeviceType, DevicePlugin>
  -configFactory: ConfigFactory
  +createDevice(type: DeviceType): DeviceResponse
}
note bottom of DeviceFactory
  At startup, receives device providers from
  the configured provider catalog.
  Validates requiredDependencies() before
  creation — mirrors the Python POC's
  DeviceFactory behaviour:
  - NOT_REGISTERED -> EXCEPTION response
  - missing dependency -> EXCEPTION response
  - success -> VALID response with device
end note

class DeviceResponse {
  +status: DeviceStatus
  +details: String
  +device: Device
}

enum DeviceStatus {
  VALID
  EXCEPTION
}

class Dependencies {
  +modbusRegistry(): ModbusClientRegistry
  +get(key: DependencyKey): Response<Object>
}

class ProviderCatalog {
  +deviceProviders(): Collection<DevicePlugin>
}

class ConfigFactory {}
class ConfigLoader {}
note bottom of ConfigLoader
  Loads the device profile (JSON):
  transport, address map, timeouts,
  and which dependencies to use
end note

' ---- Example plugins (each in its own module) ----
package "extension: blauberg-mvhr" {
  class BlaubergMVHRPlugin {}
  class BlaubergMVHR {}
}

package "extension: modbus-temp-sensor" {
  class ModbusTempSensorPlugin {}
  class ModbusTemperatureSensor {}
}

DeviceFactory o-- ProviderCatalog : obtains device providers from
ProviderCatalog o-- DevicePlugin
DeviceFactory -- ConfigFactory
DeviceFactory ..> DeviceResponse : returns
DeviceResponse -- DeviceStatus
DevicePlugin ..> Device : creates
Device ..> DeviceCommand : accepts
Device ..> DeviceQuery : accepts
DevicePlugin ..> Dependencies : receives
DevicePlugin ..> ConfigLoader : receives

BlaubergMVHRPlugin ..|> DevicePlugin
BlaubergMVHRPlugin ..> BlaubergMVHR : creates
BlaubergMVHR ..|> Device

ModbusTempSensorPlugin ..|> DevicePlugin
ModbusTempSensorPlugin ..> ModbusTemperatureSensor : creates
ModbusTemperatureSensor ..|> Device

@enduml
