@startuml
'https://plantuml.com/class-diagram
!theme spacelab

title Device Plugin Architecture — Self-Registering Devices (Java)

interface Device {
  +open(): CompletableFuture<Response<Void>>
  +read(): CompletableFuture<Response<DeviceState>>
  +close(): void
}

interface DevicePlugin {
  +deviceType(): DeviceType
  +requiredDependencies(): Set<DependencyKey>
  +create(config: ConfigLoader, deps: Dependencies): Device
}
note right of DevicePlugin
  THE plugin SPI.
  Each new device ships as a self-contained
  module (jar) providing this interface and a
  META-INF/services entry — the core framework
  and existing devices are NEVER modified.
  (Open/Closed Principle)
end note

class DeviceFactory {
  -plugins: Map<DeviceType, DevicePlugin>
  -configFactory: ConfigFactory
  +createDevice(type: DeviceType): DeviceResponse
}
note bottom of DeviceFactory
  At startup:
  ServiceLoader.load(DevicePlugin.class)
  Validates requiredDependencies() before
  creation — mirrors the Python POC's
  DeviceFactory behaviour:
  - NOT_REGISTERED -> EXCEPTION response
  - missing dependency -> EXCEPTION response
  - success -> VALID response with device
end note

class DeviceResponse {
  +status: DeviceStatus
  +details: String
  +device: Device
}

enum DeviceStatus {
  VALID
  EXCEPTION
}

class Dependencies {
  +modbusRegistry(): ModbusClientRegistry
  +get(key: DependencyKey): Response<Object>
}

class ConfigFactory {}
class ConfigLoader {}
note bottom of ConfigLoader
  Loads the device profile (JSON):
  transport, address map, timeouts,
  and which dependencies to use
end note

' ---- Example plugins (each in its own module) ----
package "plugin: blauberg-mvhr (own jar)" {
  class BlaubergMVHRPlugin {}
  class BlaubergMVHR {}
}

package "plugin: modbus-temp-sensor (own jar)" {
  class ModbusTempSensorPlugin {}
  class ModbusTemperatureSensor {}
}

DeviceFactory o-- DevicePlugin : discovers via ServiceLoader
DeviceFactory -- ConfigFactory
DeviceFactory ..> DeviceResponse : returns
DeviceResponse -- DeviceStatus
DevicePlugin ..> Device : creates
DevicePlugin ..> Dependencies : receives
DevicePlugin ..> ConfigLoader : receives

BlaubergMVHRPlugin ..|> DevicePlugin
BlaubergMVHRPlugin ..> BlaubergMVHR : creates
BlaubergMVHR ..|> Device

ModbusTempSensorPlugin ..|> DevicePlugin
ModbusTempSensorPlugin ..> ModbusTemperatureSensor : creates
ModbusTemperatureSensor ..|> Device

@enduml
