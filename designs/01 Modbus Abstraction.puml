@startuml
'https://plantuml.com/class-diagram
!theme spacelab

title Modbus Abstraction Layer (Java)

interface ModbusClient {
  +connect(): CompletableFuture<Response<Void>>
  +disconnect(): void
  +readCoils(start: int, count: int): CompletableFuture<Response<boolean[]>>
  +readDiscreteInputs(start: int, count: int): CompletableFuture<Response<boolean[]>>
  +readHoldingRegisters(start: int, count: int): CompletableFuture<Response<int[]>>
  +readInputRegisters(start: int, count: int): CompletableFuture<Response<int[]>>
  +writeCoil(address: int, value: boolean): CompletableFuture<Response<Void>>
  +writeRegister(address: int, value: int): CompletableFuture<Response<Void>>
  +isConnected(): boolean
}
note right of ModbusClient
  The ONLY Modbus API the rest of the
  system sees. Devices never touch the
  underlying library directly.
end note

interface ModbusClientFactory {
  +transport(): TransportType
  +create(settings: ConnectionSettings): ModbusClient
}
note bottom of ModbusClientFactory
  SPI: implementations self-register via
  Java ServiceLoader (META-INF/services).
  Adding a new transport or library binding
  requires NO change to existing code.
end note

enum TransportType {
  TCP
  RTU
}

class ModbusClientRegistry {
  -factories: Map<TransportType, ModbusClientFactory>
  +get(transport: TransportType, settings: ConnectionSettings): Response<ModbusClient>
}
note bottom of ModbusClientRegistry
  Discovers all ModbusClientFactory
  implementations at startup using
  ServiceLoader.load(ModbusClientFactory.class)
end note

class ConnectionSettings {
  +host: IPAddress
  +port: Port
  +serialPort: SerialPortName
  +baudRate: BaudRate
  +unitId: UnitId
  +timeout: Timeout
  +retries: Retries
}

class ConnectionManager {
  -delegate: ModbusClient
  +connect(): CompletableFuture<Response<Void>>
}
note bottom of ConnectionManager
  Decorator: adds retry, reconnect and
  error-recovery behaviour around any
  ModbusClient (TCP or RTU alike)
end note

class DigitalPetriTcpClient {}
note bottom of DigitalPetriTcpClient
  Adapter over the digitalpetri/modbus
  Java library. Registered via ServiceLoader.
end note

class DigitalPetriRtuClient {}

class Response<T> {
  +status: Status
  +details: String
  +value: T
}

enum Status {
  OK
  EXCEPTION
}

ModbusClientRegistry o-- ModbusClientFactory : discovers via ServiceLoader
ModbusClientFactory ..> ModbusClient : creates
ModbusClientFactory ..> ConnectionSettings : configured by
ModbusClientFactory -- TransportType
ConnectionManager ..|> ModbusClient : implements (decorator)
ConnectionManager o-- ModbusClient : wraps
DigitalPetriTcpClient ..|> ModbusClient
DigitalPetriRtuClient ..|> ModbusClient
ModbusClient ..> Response : returns
Response -- Status

@enduml
